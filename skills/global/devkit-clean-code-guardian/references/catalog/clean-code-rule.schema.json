{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/clean-code-rule.schema.json",
  "title": "Clean Code Rule Catalog",
  "type": "object",
  "required": [
    "catalog",
    "version",
    "schema",
    "language",
    "rule_count",
    "rules"
  ],
  "properties": {
    "catalog": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "schema": {
      "const": "clean-code-rule-v1"
    },
    "language": {
      "type": "string",
      "enum": ["kotlin", "java", "python"]
    },
    "rule_count": {
      "type": "integer",
      "minimum": 0
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": [
        "id",
        "language",
        "category",
        "severity",
        "title",
        "description",
        "detection",
        "fix_strategy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(CC-KT|CC-JV|CC-PY)-[0-9]{3}$"
        },
        "language": {
          "type": "string",
          "enum": ["kotlin", "java", "python"]
        },
        "category": {
          "type": "string",
          "enum": [
            "naming",
            "names",
            "functions",
            "classes",
            "general",
            "comments",
            "tests",
            "formatting",
            "complexity",
            "error-handling",
            "testing",
            "architecture",
            "concurrency",
            "collections",
            "documentation"
          ]
        },
        "severity": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low"]
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "description": {
          "type": "string",
          "minLength": 10
        },
        "rationale": {
          "type": "string"
        },
        "detection": {
          "$ref": "#/$defs/detection"
        },
        "bad_example": {
          "type": "string"
        },
        "good_example": {
          "type": "string"
        },
        "fix_strategy": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "detection": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["threshold", "pattern", "semantic", "manual-check"]
        },
        "metric": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": ["<=", "<", ">", ">=", "==", "!="]
        },
        "value": {
          "oneOf": [
            { "type": "number" },
            { "type": "string" },
            { "type": "boolean" }
          ]
        },
        "pattern": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
